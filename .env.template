# Copy to .env and fill in. .env is gitignored; this template is committed.
# Nothing loads .env automatically:
#   set -a; . ./.env; set +a
#
# Variables are grouped by the skill that reads them. A skill with no entry
# needs no configuration.


# --- skills/ondoku3-tts ---------------------------------------------------
# No configuration. Output defaults to /tmp/common-skills/ondoku3-tts.


# --- skills/iconify-svg ---------------------------------------------------
# No configuration. No API key needed. Output defaults to
# /tmp/common-skills/iconify-svg.


# --- skills/unsplash-search -----------------------------------------------
# Required. Create a key at https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=

# Optional. Where the used-photo ledger lives.
# UNSPLASH_LEDGER_PATH=/tmp/common-skills/unsplash-search/used-photos.json
